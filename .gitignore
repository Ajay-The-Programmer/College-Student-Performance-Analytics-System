# ==============================================================================
# .gitignore - College Student Performance Analytics System
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cookie
.hypothesis/
.pytest_cache/

# Virtual Environments
venv/
.venv/
ENV/
env/

# Environment Variables & Local Config
.env
.env.local

# IDEs & Text Editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Datasets and generated models (exclude large raw files while tracking placeholder)
datasets/*
!datasets/.gitkeep

# SQLite local testing databases
*.db
*.sqlite
*.sqlite3
