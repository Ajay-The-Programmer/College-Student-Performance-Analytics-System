# ==============================================================================
# Environment Configuration Template
# Project: College Student Performance Analytics System
# Usage: Copy this file to '.env' and populate with actual credentials.
# ==============================================================================

# Flask Core Application Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# MySQL Database Configuration Placeholders
# Format: mysql+pymysql://<MYSQL_USER>:<MYSQL_PASSWORD>@<MYSQL_HOST>:<MYSQL_PORT>/<MYSQL_DB>
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=student_analytics_db

# SQLAlchemy Connection String (Auto-constructed from individual parameters if not explicitly overridden)
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/student_analytics_db
